[Unit]
Description=s2l (SOCKS5 to L2TP)
After=network-online.target xl2tpd.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/s2l
ExecStart=/opt/s2l/s2l -config /opt/s2l/config.json
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576

# 保留 running 状态，由 auto_restore 在下次启动时恢复映射
KillMode=mixed
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
